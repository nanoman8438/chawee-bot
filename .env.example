LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GROQ_API_KEY=
OPENWEATHER_API_KEY=
# Comma-separated LINE group IDs that always receive daily posts (see "GROUP_ID stored" in logs)
GROUP_IDS=
# Optional: eldestSon (default) or narcissist
PERSONA=
# Optional: Groq model that can read images
VISION_MODEL=
# Free Gemini key from aistudio.google.com, used only when Groq fails
GEMINI_API_KEY=
# Optional: Gemini model for the fallback (default gemini-3.5-flash-lite)
GEMINI_MODEL=
